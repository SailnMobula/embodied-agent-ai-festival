---
import BaseLayout from './BaseLayout.astro'
import StationPager from '@/components/StationPager.astro'
import type { Station, StationNeighbours } from '@/lib/stations'

type Props = {
  station: Station
  neighbours: StationNeighbours
}

const { station, neighbours } = Astro.props
const { order, title, tagline, durationMinutes, takeaway } = station.data
---

<BaseLayout title={`${order}. ${title} · Embodied Agents Workshop`} description={tagline}>
  <article class="mx-auto max-w-4xl px-6 py-16">
    <header class="mb-14">
      <p class="text-sm font-bold text-muted-foreground">
        Station {order} · {durationMinutes} min
      </p>
      <h1 class="font-display mt-3 text-station leading-[1.05] text-foreground text-balance">
        {title}
      </h1>
      <p class="mt-5 text-lead text-muted-foreground text-pretty">{tagline}</p>
    </header>

    <div class="station-content">
      <slot />
    </div>

    <aside class="mt-16 rounded-card border-l-4 border-accent bg-card p-6">
      <p class="text-sm font-bold text-muted-foreground">Takeaway</p>
      <p class="mt-2 text-lead font-bold text-card-foreground text-pretty">{takeaway}</p>
    </aside>

    <StationPager previous={neighbours.previous} next={neighbours.next} />
  </article>
</BaseLayout>

<style is:global>
  .station-content > * + * {
    margin-block-start: 1.4em;
  }
  .station-content h2 {
    border-block-start: 1px solid var(--color-border);
    color: var(--color-foreground);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.75em;
    letter-spacing: -1px;
    line-height: 1.2;
    margin-block-start: 4.5em;
    padding-block-start: 2.2em;
    text-wrap: balance;
  }
  .station-content h2:first-child {
    border-block-start: none;
    margin-block-start: 0;
    padding-block-start: 0;
  }
  .station-content h3 {
    color: var(--color-foreground);
    font-size: 1.25em;
    font-weight: 700;
    margin-block-start: 1.8em;
  }
  .station-content ul,
  .station-content ol {
    padding-inline-start: 1.4em;
  }
  .station-content ul {
    list-style: disc;
  }
  .station-content ol {
    list-style: decimal;
  }
  .station-content li + li {
    margin-block-start: 0.5em;
  }
  .station-content li::marker {
    color: var(--color-muted-foreground);
  }
  .station-content strong {
    color: var(--color-foreground);
    font-weight: 700;
  }
  .station-content a {
    color: var(--color-accent);
    text-underline-offset: 4px;
    text-decoration-line: underline;
  }
  .station-content code {
    background-color: var(--color-secondary);
    border-radius: var(--radius-container);
    font-family: var(--font-mono);
    font-size: 0.88em;
    padding: 0.15em 0.4em;
  }
  .station-content pre {
    background-color: var(--color-card) !important;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    font-size: 0.85em;
    overflow-x: auto;
    padding: 1.25rem 1.4rem;
  }
  .station-content pre code {
    background: none;
    padding: 0;
  }
  .station-content blockquote {
    border-inline-start: 2px solid var(--color-border-strong);
    color: var(--color-muted-foreground);
    font-style: italic;
    padding-inline-start: 1.2em;
  }
  .station-content table {
    border-collapse: collapse;
    display: block;
    overflow-x: auto;
    width: 100%;
  }
  .station-content th,
  .station-content td {
    border-block-end: 1px solid var(--color-border);
    padding: 0.7em 1em;
    text-align: start;
    vertical-align: top;
  }
  .station-content th {
    color: var(--color-foreground);
    font-size: 0.85em;
    font-weight: 700;
  }
</style>

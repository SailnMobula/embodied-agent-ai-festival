---
import type { Station } from '@/lib/stations'
import { overviewRoute, stationRoute } from '@/lib/routes'

type Props = {
  previous: Station | undefined
  next: Station | undefined
}

const { previous, next } = Astro.props
---

<nav
  aria-label="Station navigation"
  class="mt-20 grid gap-4 border-t border-border pt-8 sm:grid-cols-3 sm:items-center"
>
  {
    previous ? (
      <a href={stationRoute(previous.id)} class="group text-muted-foreground hover:text-foreground">
        <span class="block text-xs">Previous</span>
        <span class="text-lead font-bold text-foreground">← {previous.data.title}</span>
      </a>
    ) : (
      <span />
    )
  }

  <a
    href={overviewRoute()}
    class="text-center text-sm text-muted-foreground hover:text-foreground"
  >
    Overview
  </a>

  {
    next ? (
      <a
        href={stationRoute(next.id)}
        class="group text-right text-muted-foreground hover:text-foreground sm:justify-self-end"
      >
        <span class="block text-xs">Next</span>
        <span class="text-lead font-bold text-foreground">{next.data.title} →</span>
      </a>
    ) : (
      <span />
    )
  }
</nav>

---
type Props = {
  src: string
  poster: string
  caption: string
}

const { src, poster, caption } = Astro.props
const media = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/media`
---

<figure class="my-10 overflow-hidden rounded-card border border-border bg-card">
  <video
    class="block w-full bg-background"
    src={`${media}/${src}`}
    poster={`${media}/${poster}`}
    controls
    loop
    muted
    playsinline
    preload="metadata"></video>
  <figcaption class="border-t border-border px-6 py-3 text-sm text-muted-foreground">
    {caption}
  </figcaption>
</figure>

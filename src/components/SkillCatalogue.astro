---
const skills = [
  { name: 'Move', detail: 'Wave, point, gesture' },
  { name: 'See', detail: 'Count people, read hand gestures' },
  { name: 'Express', detail: 'A face on the screen, a sound' },
]
---

<figure class="my-10 grid gap-4 sm:grid-cols-3">
  {
    skills.map((skill) => (
      <div class="rounded-card border border-border bg-card p-6">
        <p class="text-lead font-bold text-card-foreground">{skill.name}</p>
        <p class="mt-1 text-muted-foreground">{skill.detail}</p>
      </div>
    ))
  }
</figure>

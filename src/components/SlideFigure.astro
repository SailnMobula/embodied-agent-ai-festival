---
import { Image } from 'astro:assets'

type Props = {
  src: ImageMetadata
  alt: string
  caption: string
}

const { src, alt, caption } = Astro.props
---

<figure class="my-10 overflow-hidden rounded-card border border-border bg-card">
  <Image
    src={src}
    alt={alt}
    widths={[640, 960, 1280, 1600]}
    sizes="(min-width: 64rem) 56rem, 100vw"
    class="block w-full"
  />
  <figcaption class="border-t border-border px-6 py-3 text-sm text-muted-foreground">
    {caption}
  </figcaption>
</figure>

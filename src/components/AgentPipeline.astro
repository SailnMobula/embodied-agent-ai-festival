---
const BOXES = [
  { x: 20, width: 130, label: 'Speech in', detail: 'microphone' },
  { x: 186, width: 190, label: 'Realtime model', detail: 'persona · event · self' },
  { x: 412, width: 130, label: 'Skill call', detail: 'wave, set_face' },
  { x: 578, width: 140, label: 'LiDAR gate', detail: 'clear or blocked' },
  { x: 754, width: 130, label: 'Body move', detail: 'arm, face, sound' },
]

const ROW_Y = 40
const ROW_HEIGHT = 62
const CENTER_Y = ROW_Y + ROW_HEIGHT / 2
---

<figure class="my-10 overflow-hidden rounded-card border border-border bg-card">
  <svg viewBox="0 0 904 272" class="w-full bg-background" role="presentation">
    <defs>
      <marker
        id="pipeline-arrow"
        viewBox="0 0 10 10"
        refX={9}
        refY={5}
        markerWidth={6}
        markerHeight={6}
        orient="auto-start-reverse"
      >
        <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--color-ex-grey-400)" />
      </marker>
    </defs>

    {
      BOXES.slice(0, -1).map((box, index) => (
        <line
          x1={box.x + box.width}
          y1={CENTER_Y}
          x2={BOXES[index + 1].x}
          y2={CENTER_Y}
          stroke="var(--color-ex-grey-400)"
          stroke-width={2}
          marker-end="url(#pipeline-arrow)"
        />
      ))
    }

    {
      BOXES.map((box) => (
        <>
          <rect
            x={box.x}
            y={ROW_Y}
            width={box.width}
            height={ROW_HEIGHT}
            rx={8}
            fill="var(--color-card)"
            stroke="var(--color-border-strong)"
            stroke-width={2}
          />
          <text
            x={box.x + box.width / 2}
            y={ROW_Y + 26}
            text-anchor="middle"
            font-size={15}
            font-weight={700}
            fill="var(--color-foreground)"
          >
            {box.label}
          </text>
          <text
            x={box.x + box.width / 2}
            y={ROW_Y + 46}
            text-anchor="middle"
            font-family="var(--font-mono)"
            font-size={11}
            fill="var(--color-ex-grey-600)"
          >
            {box.detail}
          </text>
        </>
      ))
    }

    <line
      x1={648}
      y1={ROW_Y + ROW_HEIGHT}
      x2={648}
      y2={148}
      stroke="var(--color-accent)"
      stroke-width={2}
      stroke-dasharray="5 4"
    />
    <rect
      x={548}
      y={148}
      width={200}
      height={46}
      rx={8}
      fill="var(--color-accent)"
      fill-opacity={0.15}
      stroke="var(--color-accent)"
      stroke-width={2}
    />
    <text x={648} y={168} text-anchor="middle" font-size={13} font-weight={700} fill="var(--color-foreground)">
      blocked
    </text>
    <text
      x={648}
      y={185}
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size={11}
      fill="var(--color-ex-grey-600)"
    >
      no_space: face + sound
    </text>

    <path
      d="M 819 102 L 819 246 L 281 246 L 281 102"
      fill="none"
      stroke="var(--color-ex-grey-400)"
      stroke-width={2}
      stroke-dasharray="6 5"
      marker-end="url(#pipeline-arrow)"
    />
    <text
      x={420}
      y={238}
      text-anchor="middle"
      font-family="var(--font-mono)"
      font-size={11}
      fill="var(--color-ex-grey-600)"
    >
      what happened, back into the conversation
    </text>
  </svg>

  <figcaption class="border-t border-border px-6 py-3 text-sm text-muted-foreground">
    The model never touches a motor. It calls a skill, and the gate decides whether the robot moves.
  </figcaption>
</figure>

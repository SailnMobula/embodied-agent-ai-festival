---
import { loadStationsInOrder } from '@/lib/stations'
import { overviewRoute, stationRoute } from '@/lib/routes'

const stations = await loadStationsInOrder()
const currentPath = Astro.url.pathname
---

<header class="sticky top-0 z-40 border-b border-border bg-background/90 backdrop-blur-md">
  <nav
    aria-label="Workshop stations"
    class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-4 gap-y-2 px-6 py-3"
  >
    <span class="font-display text-xl text-foreground" aria-label="Exxeta">exxeta</span>
    <span class="hidden h-5 w-px bg-border-strong sm:block" aria-hidden="true"></span>
    <a
      href={overviewRoute()}
      class="text-sm font-bold text-foreground hover:text-accent"
    >
      Overview
    </a>
    <ol class="flex flex-wrap items-center gap-x-2 gap-y-2">
      {
        stations.map((station) => (
          <li>
            <a
              href={stationRoute(station.id)}
              aria-current={currentPath.includes(station.id) ? 'page' : undefined}
              class="block rounded-pill px-3 py-1 text-sm text-muted-foreground hover:text-foreground aria-[current=page]:bg-accent aria-[current=page]:font-bold aria-[current=page]:text-accent-foreground"
            >
              <span class="tabular-nums">{station.data.order}</span>
              <span class="ml-1.5 hidden sm:inline">{station.data.title}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
</header>

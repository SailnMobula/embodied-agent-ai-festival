---
const SHOULDER = { x: 40, y: 96 }
const ELBOW = { x: 70, y: 64 }
const KEYFRAMES = [
  { hand: { x: 44, y: 49 }, time: '0.0', label: { x: 6, y: 44 } },
  { hand: { x: 67, y: 34 }, time: '0.4', label: { x: 56, y: 22 } },
  { hand: { x: 93, y: 45 }, time: '0.8', label: { x: 100, y: 40 } },
]

const GROUND = 104
const ATTEMPTS = [
  { x: 44, tilt: -29 },
  { x: 67, tilt: -15 },
  { x: 113, tilt: 17 },
  { x: 136, tilt: 31 },
]
---

<figure class="my-10 grid gap-4 sm:grid-cols-2">
  <div class="rounded-card border border-border bg-card p-5">
    <svg viewBox="0 0 180 120" class="w-full" role="presentation">
      <line
        x1={SHOULDER.x}
        y1={SHOULDER.y}
        x2={SHOULDER.x}
        y2={GROUND + 12}
        stroke="var(--color-ex-grey-600)"
        stroke-width={7}
        stroke-linecap="round"
      />

      <g stroke="var(--color-border-strong)" stroke-width={5} stroke-linecap="round" fill="none">
        {
          [KEYFRAMES[0], KEYFRAMES[2]].map(({ hand }) => (
            <line x1={ELBOW.x} y1={ELBOW.y} x2={hand.x} y2={hand.y} />
          ))
        }
      </g>

      <g stroke="var(--color-ex-grey-600)" stroke-width={6} stroke-linecap="round" fill="none">
        <line x1={SHOULDER.x} y1={SHOULDER.y} x2={ELBOW.x} y2={ELBOW.y} />
        <line x1={ELBOW.x} y1={ELBOW.y} x2={KEYFRAMES[1].hand.x} y2={KEYFRAMES[1].hand.y} />
      </g>

      <path
        d={`M ${KEYFRAMES[0].hand.x} ${KEYFRAMES[0].hand.y} Q ${KEYFRAMES[1].hand.x} 24 ${KEYFRAMES[2].hand.x} ${KEYFRAMES[2].hand.y}`}
        fill="none"
        stroke="var(--color-accent)"
        stroke-width={2}
        stroke-dasharray="5 4"
      />

      {
        KEYFRAMES.map(({ hand, time, label }) => (
          <>
            <circle cx={hand.x} cy={hand.y} r={4} fill="var(--color-accent)" />
            <text
              x={label.x}
              y={label.y}
              font-family="var(--font-mono)"
              font-size={8}
              fill="var(--color-ex-grey-600)"
            >
              t = {time}
            </text>
          </>
        ))
      }
    </svg>

    <p class="mt-4 font-bold text-card-foreground">Teaching</p>
    <p class="mt-1 text-sm font-bold text-muted-foreground">Record the motion once.</p>
    <p class="mt-2 text-sm text-muted-foreground">
      Guide the arm through the gesture, save the joint angles with their timestamps, replay the
      file. Identical every single time — and identical is exactly the point.
    </p>
    <p class="mt-3 font-mono text-xs text-muted-foreground">wave.json · 43 rows of angles</p>
  </div>

  <div class="rounded-card border border-border bg-card p-5">
    <svg viewBox="0 0 180 120" class="w-full" role="presentation">
      <line
        x1={16}
        y1={GROUND}
        x2={164}
        y2={GROUND}
        stroke="var(--color-border-strong)"
        stroke-width={2}
        stroke-dasharray="6 8"
      />

      {
        ATTEMPTS.map(({ x, tilt }) => (
          <g
            transform={`translate(${x} ${GROUND}) rotate(${tilt})`}
            stroke="var(--color-border-strong)"
            stroke-width={3}
            stroke-linecap="round"
            fill="none"
          >
            <circle cx={0} cy={-46} r={5} fill="var(--color-border-strong)" stroke="none" />
            <line x1={0} y1={-41} x2={0} y2={-22} />
            <line x1={0} y1={-36} x2={-9} y2={-26} />
            <line x1={0} y1={-36} x2={9} y2={-26} />
            <line x1={0} y1={-22} x2={-6} y2={0} />
            <line x1={0} y1={-22} x2={6} y2={0} />
          </g>
        ))
      }

      <g
        transform={`translate(90 ${GROUND})`}
        stroke="var(--color-ex-grey-600)"
        stroke-width={4}
        stroke-linecap="round"
        fill="none"
      >
        <circle cx={0} cy={-46} r={6} fill="var(--color-ex-grey-600)" stroke="none" />
        <line x1={0} y1={-40} x2={0} y2={-22} />
        <line x1={0} y1={-36} x2={-9} y2={-26} />
        <line x1={0} y1={-36} x2={9} y2={-26} />
        <line x1={0} y1={-22} x2={-6} y2={0} />
        <line x1={0} y1={-22} x2={6} y2={0} />
      </g>

      <path
        d="M 46 58 A 44 44 0 0 1 134 58"
        fill="none"
        stroke="var(--color-accent)"
        stroke-width={2}
      />
      <polygon points="130,50 138,50 134,61" fill="var(--color-accent)" />
    </svg>

    <p class="mt-4 font-bold text-card-foreground">Training</p>
    <p class="mt-1 text-sm font-bold text-muted-foreground">Reward the behaviour, keep the policy.</p>
    <p class="mt-2 text-sm text-muted-foreground">
      Thousands of simulated robots try, fall, and get scored on staying upright. What survives is
      not a path but a reflex: sensor readings in, joint targets out, fifty times a second.
    </p>
    <p class="mt-3 font-mono text-xs text-muted-foreground">4096 robots in sim · one policy out</p>
  </div>
</figure>
